{
  "schemaVersion": 2,
  "uiRuntime": 1,
  "id": "app.hiraya.text-editor",
  "name": "Integrated Editor",
  "version": "1.4.0",
  "entrypoint": "index.html",
  "description": "An integrated text editor and read-only preview for other files.",
  "permissions": ["files:read", "files:write", "dialogs", "window", "commands", "theme", "storage"],
  "fileTypes": ["application/*", "audio/*", "font/*", "image/*", "message/*", "model/*", "text/*", "video/*", ".txt", ".log", ".csv", ".css", ".html", ".js", ".json", ".ts", ".xml", ".yaml", ".yml"],
  "window": {
    "renderWidth": 818,
    "renderHeight": 572,
    "minWidth": 360,
    "minHeight": 260
  }
}
