{
  "manifest_version": 3,
  "name": "Hiraya New Tab",
  "version": "0.1.0",
  "description": "Open Hiraya whenever you create a new tab.",
  "homepage_url": "https://hiraya.sh/",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
